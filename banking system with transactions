#banking System with Transactions


import time

accounts = {
    "1001": 5000,
    "1002": 3000,
    "1003": 7000
}

def display_accounts():
    print("\nAccount Details:")
    for acc, balance in accounts.items():
        print(f"Account: {acc} | Balance: {balance}")


def transfer_money():
    try:
        sender = input("Enter Sender Account Number: ").strip()
        receiver = input("Enter Receiver Account Number: ").strip()

        if sender not in accounts or receiver not in accounts:
            raise KeyError("Incorrect account number.")

        amount = float(input("Enter Amount to Transfer: "))

        if amount <= 0:
            raise ValueError("Amount must be positive.")

        if accounts[sender] < amount:
            raise ValueError("Overdraft error: Insufficient balance.")

        print("Processing transaction...")
        time.sleep(2)  # Simulate transaction delay

        # Simulated timeout condition
        if amount > 10000:
            raise TimeoutError("Transaction timeout. Try again later.")

        accounts[sender] -= amount
        accounts[receiver] += amount

        print("Transaction successful.")

    except KeyError as e:
        print("Error:", e)
    except ValueError as e:
        print("Error:", e)
    except TimeoutError as e:
        print("Error:", e)


def deposit():
    try:
        acc = input("Enter Account Number: ").strip()
        if acc not in accounts:
            raise KeyError("Incorrect account number.")

        amount = float(input("Enter Deposit Amount: "))
        if amount <= 0:
            raise ValueError("Amount must be positive.")

        accounts[acc] += amount
        print("Deposit successful.")

    except (KeyError, ValueError) as e:
        print("Error:", e)


def menu():
    while True:
        print("\n--- Banking System ---")
        print("1. Display Accounts")
        print("2. Transfer Money")
        print("3. Deposit")
        print("4. Exit")

        choice = input("Enter choice: ")

        if choice == '1':
            display_accounts()
        elif choice == '2':
            transfer_money()
        elif choice == '3':
            deposit()
        elif choice == '4':
            print("Exiting Banking System...")
            break
        else:
            print("Invalid choice.")


menu()