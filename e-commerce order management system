# E-Commerce Order Management System

products = {
    "Laptop": {"price": 50000, "stock": 5},
    "Phone": {"price": 20000, "stock": 10},
    "Headphones": {"price": 2000, "stock": 15}
}

valid_coupons = {"SAVE10": 0.10, "SAVE20": 0.20}
valid_payments = ["card", "upi", "cash"]

orders = {}

def place_order():
    try:
        product = input("Enter product name: ").strip()

        if product not in products:
            raise ValueError("Product not found.")

        quantity = int(input("Enter quantity: "))
        if quantity <= 0:
            raise ValueError("Quantity must be positive.")

        if products[product]["stock"] < quantity:
            raise ValueError("Out-of-stock error.")

        coupon = input("Enter coupon code (or press Enter to skip): ").strip()
        discount = 0

        if coupon:
            if coupon not in valid_coupons:
                raise ValueError("Invalid coupon code.")
            discount = valid_coupons[coupon]

        payment = input("Enter payment method (card/upi/cash): ").strip().lower()
        if payment not in valid_payments:
            raise ValueError("Invalid payment method.")

        total = products[product]["price"] * quantity
        total -= total * discount

        order_id = len(orders) + 1
        orders[order_id] = {"product": product, "quantity": quantity, "total": total}

        products[product]["stock"] -= quantity

        print(f"Order placed successfully. Order ID: {order_id}")
        print(f"Total amount: {total}")

    except ValueError as e:
        print("Error:", e)


def return_order():
    try:
        order_id = int(input("Enter Order ID to return: "))

        if order_id not in orders:
            raise ValueError("Invalid Order ID.")

        product = orders[order_id]["product"]
        quantity = orders[order_id]["quantity"]

        products[product]["stock"] += quantity
        refund = orders[order_id]["total"]

        del orders[order_id]

        print(f"Order returned successfully. Refund amount: {refund}")

    except ValueError as e:
        print("Error:", e)


def show_products():
    print("\nAvailable Products:")
    for p, info in products.items():
        print(f"{p} | Price: {info['price']} | Stock: {info['stock']}")


def menu():
    while True:
        print("\n--- E-Commerce System ---")
        print("1. Show Products")
        print("2. Place Order")
        print("3. Return Order")
        print("4. Exit")

        choice = input("Enter choice: ")

        if choice == '1':
            show_products()
        elif choice == '2':
            place_order()
        elif choice == '3':
            return_order()
        elif choice == '4':
            print("Exiting system...")
            break
        else:
            print("Invalid choice.")

menu()